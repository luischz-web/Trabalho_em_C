#include <stdio.h>

int main() {
    float n1, n2;

    printf("Digite o primeiro numero: ");
    scanf("%f", &n1);
    printf("Digite o segundo numero: ");
    scanf("%f", &n2);

    if (n1 > n2) {
        printf("\n%.2f e maior que %.2f.\n", n1, n2);
    } else if (n1 == n2) {
        printf("\nOs numeros sao iguais: %.2f.\n", n1);
    } else {
        printf("\n%.2f e maior que %.2f.\n", n2, n1);
    }

    return 0;
}