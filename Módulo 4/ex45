#include <stdio.h>

int main() {
    float nota;

    printf("Digite uma nota: ");
    scanf("%f", &nota);

    while (nota < 0 || nota > 10) {
        printf("Nota invalida! Digite novamente: ");
        scanf("%f", &nota);
    }

    printf("Nota valida: %.2f\n", nota);

    return 0;
}
