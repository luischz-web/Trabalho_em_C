#include <stdio.h>

int main() {
    int n1, n2;

    printf("Digite o primeiro inteiro positivo: ");
    scanf("%d", &n1);
    printf("Digite o segundo inteiro positivo: ");
    scanf("%d", &n2);

    printf("\nSoma           : %d + %d = %d\n", n1, n2, n1 + n2);
    printf("Subtracao      : %d - %d = %d\n", n1, n2, n1 - n2);
    printf("Multiplicacao  : %d * %d = %d\n", n1, n2, n1 * n2);

    if (n2 != 0) {
        printf("resultado: %d / %d = %d\n", n1, n2, n1 / n2);
        printf("Restante: %d %% %d = %d\n", n1, n2, n1 % n2);
    } else {
        printf("Divisao e resto indefinidos: divisor igual a zero.\n");
    }

    return 0;
}