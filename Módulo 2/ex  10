#include <stdio.h>

int main() {
    float k, f, c;

    printf("Digite a temperatura em graus Celsius: ");
    scanf("%f", &c);

    f = (c * 9.0 / 5.0) + 32.0;
    k = c + 273.15;

    printf("\nCelsius    : %.2f C\n", c);
    printf("Fahrenheit : %.2f F\n", f);
    printf("Kelvin     : %.2f K\n", k);

    return 0;
}