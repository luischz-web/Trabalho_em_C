#include <stdio.h>

int main() {
    int n;

    printf("Digite um numero inteiro: ");
    scanf("%d", &n);

    if (n > 0) {
        printf("%d e positivo.\n", n);
    } else if (n < 0) {
        printf("%d e negativo.\n", n);
    } else {
        printf("O numero e zero (nulo).\n");
    }

    return 0;
}