#include <stdio.h>

int main() {
    int   horas;
    float valor_hora, bruto, inss, ir, liquido;

    printf("Horas trabalhadas: ");
    scanf("%d", &horas);
    printf("Valor da hora (R$): ");
    scanf("%f", &valor_hora);

    bruto = horas * valor_hora;
    inss  = bruto * 0.11f;
    ir = bruto * 0.05f;
    liquido = bruto - inss - ir;

    printf("Salario bruto   : R$ %9.2f\n", bruto);
    printf("Desconto previd. (11%%) : R$ %9.2f\n", inss);
    printf("Imposto de renda (5%%)  : R$ %9.2f\n", ir);
    printf("Salario liquido        : R$ %9.2f\n", liquido);

    return 0;
}