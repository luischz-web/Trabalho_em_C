#include <stdio.h>

int main() {
    float a, b, c;

    printf("Lado A: ");
    scanf("%f", &a);
    printf("Lado B: ");
    scanf("%f", &b);
    printf("Lado C: ");
    scanf("%f", &c);

    if (a <= 0 || b <= 0 || c <= 0) {
        printf("\nOs lados devem ser positivos.\n");
    } else if (a < b + c && b < a + c && c < a + b) {
        if (a == b && b == c) {
            printf("\nTriangulo EQUILATERO.\n");
        } else if (a == b || a == c || b == c) {
            printf("\nTriangulo ISOSCELES.\n");
        } else {
            printf("\nTriangulo ESCALENO.\n");
        }
    } else {
        printf("\nOs lados nao formam um triangulo.\n");
    }

    return 0;
}