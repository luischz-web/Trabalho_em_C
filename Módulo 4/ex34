#include <stdio.h>

int main() {
    int n, i;
    float valor, soma = 0;

    printf("Quantidade (N): ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Valor %d: ", i + 1);
        scanf("%f", &valor);
        soma += valor;
    }

    printf("Soma: %.2f\nMedia: %.2f\n", soma, soma / n);

    return 0;
}