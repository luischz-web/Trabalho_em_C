#include <stdio.h>

int main() {
    float massa, altura, imc;

    printf("Massa (kg): ");
    scanf("%f", &massa);
    printf("Altura (m): ");
    scanf("%f", &altura);

    if (altura <= 0) {
        printf("\nAltura invalida.\n");
        return 0;
    }

    imc = massa / (altura * altura);

    printf("\nIMC: %.2f\n", imc);

    if (imc < 18.5) {
        printf("Classificacao: magreza.\n");
    } else if (imc < 25.0) {
        printf("Classificacao: peso adequado.\n");
    } else if (imc < 30.0) {
        printf("Classificacao: sobrepeso.\n");
    } else {
        printf("Classificacao: obesidade.\n");
    }

    return 0;
}