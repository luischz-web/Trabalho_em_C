#include <stdio.h>

int main() {
    int id, bloqueado;

    printf("Numero do cracha: ");
    scanf("%d", &id);
    printf("Usuario suspenso? (1 = sim, 0 = nao): ");
    scanf("%d", &bloqueado);

    if (id == 1001 && !bloqueado) {
        printf("\nACESSO LIBERADO.\n");
    } else {
        printf("\nACESSO NEGADO.\n");
    }

    return 0;
}
