#include <stdio.h>

int main() {
    int opcao;
    float n1, n2;

    while (opcao != 0) {
        printf("\n1 - Soma\n");
        printf("2 - Multiplicacao\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            printf("Digite dois numeros: ");
            scanf("%f %f", &n1, &n2);
            printf("Resultado: %.2f\n", n1 + n2);
        } else if (opcao == 2) {
            printf("Digite dois numeros: ");
            scanf("%f %f", &n1, &n2);
            printf("Resultado: %.2f\n", n1 * n2);
        } else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }
    }

    return 0;
}