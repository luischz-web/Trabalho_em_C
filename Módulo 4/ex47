#include <stdio.h>

int main() {
    float popA = 80000, popB = 100000;
    int anos = 0;

    while (popA <= popB) {
        popA = popA * 1.03;
        popB = popB * 1.015;
        anos++;
    }

    printf("Anos: %d\n", anos);
    printf("Populacao A: %.2f\n", popA);
    printf("Populacao B: %.2f\n", popB);

    return 0;
}